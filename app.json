{
  "expo": {
    "name": "EPMAPS_Tracker",
    "slug": "epmaps-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/epmaps-tracker-icon.png",
    "scheme": "epmaps-tracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.epn.epmaps.tracker"
    },
    "android": {
      "package": "ec.edu.epn.epmaps.tracker",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Necesitamos la cámara para fotografiar el medidor como respaldo de la lectura."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94ee3839-2db7-48bc-a862-3cba740333a8"
      }
    }
  }
}
