{
  "expo": {
    "name": "EPMAPS_Tracker",
    "slug": "epmaps-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/epmaps-tracker-icon.png",
    "scheme": "epmaps-tracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.epn.epmaps.tracker"
    },
    "android": {
      "package": "ec.edu.epn.epmaps.tracker",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
